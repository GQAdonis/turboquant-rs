# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo.lock (ignored for library crates, keep for binary crates)
# For libraries, contributors should use their own dependency resolution
# For binaries, commit this file to ensure reproducible builds
# This is a library crate, so we ignore it:
Cargo.lock

# Benchmark outputs
/criterion/
*.criterion/
/benches/*.html

# Documentation build
/doc/
/target/doc/

